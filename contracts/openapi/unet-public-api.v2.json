{
  "openapi": "3.1.0",
  "info": {
    "title": "U-net Sovereign Core V2 Public API",
    "version": "1.0.0-rc.1",
    "description": "Public discovery, hosted verification, and exact Ledger V2 interfaces. Provider-owned login and issuance routes are described by each verified service manifest."
  },
  "paths": {
    "/v2/services/resolve": {
      "get": {
        "operationId": "resolveService",
        "parameters": [
          { "name": "serviceId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "origin", "in": "query", "required": true, "schema": { "type": "string", "format": "uri" } }
        ],
        "responses": {
          "200": {
            "description": "Verified service metadata",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceResolution" } } }
          }
        }
      }
    },
    "/v1/mini-programs": {
      "get": {
        "operationId": "listMiniPrograms",
        "responses": { "200": { "description": "Catalog page", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "programs"], "properties": { "success": { "const": true }, "programs": { "type": "array", "items": { "$ref": "#/components/schemas/MiniProgram" } } } } } } } }
      }
    },
    "/v1/verification-checks": {
      "get": {
        "operationId": "listVerificationChecks",
        "responses": { "200": { "description": "Verification check catalog", "content": { "application/json": { "schema": { "type": "object", "required": ["checks"], "properties": { "checks": { "type": "array", "items": { "$ref": "#/components/schemas/VerificationCheck" } } } } } } } }
      }
    },
    "/v1/verification-sessions": {
      "post": {
        "operationId": "createVerificationSession",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["verifierId", "verifierDisplayName"], "properties": { "verifierId": { "type": "string" }, "verifierDisplayName": { "type": "string" }, "requestType": { "type": "string" }, "requestedChecks": { "type": "array", "items": { "$ref": "#/components/schemas/VerificationCheck" } } } } } } },
        "responses": { "201": { "description": "Hosted verifier session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerificationSession" } } } } }
      }
    },
    "/v1/verification-sessions/{sessionId}": {
      "get": {
        "operationId": "getVerificationSession",
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Verifier result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerificationSession" } } } } }
      }
    },
    "/v2/attestations/{commitment}": {
      "get": {
        "operationId": "resolveLedgerV2Attestation",
        "parameters": [{ "name": "commitment", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } }],
        "responses": { "200": { "description": "Exact on-chain lifecycle status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LedgerAttestation" } } } } }
      }
    },
    "/v2/operations/revoke/holder": {
      "post": {
        "operationId": "submitHolderRevocation",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["operation", "signature"], "properties": { "operation": { "type": "object", "additionalProperties": true }, "signature": { "type": "string" } } } } } },
        "responses": { "202": { "description": "Signed operation accepted by relayer" } }
      }
    },
    "/v2/operations/anchor/reconcile": {
      "post": {
        "operationId": "reconcileLedgerV2Anchor",
        "description": "Read-only recovery of an exact previously signed anchor after a lost response. The original signed operation stays in the request body, never in URLs or logs. An index row only locates a candidate; confirmation requires matching canonical chain evidence and active status. No transaction is submitted. At most eight concurrent requests per gateway, a 4096-byte body limit and ten-second total deadline apply. Responses are no-store. The result trusts the configured gateway/RPC; it is not a light-client proof or a delivery authorization.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LedgerAnchorReconciliationRequest" } } }
        },
        "responses": {
          "200": { "description": "Exact anchor evidence confirmed at the returned canonical head", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LedgerAnchorReconciliationConfirmed" } } } },
          "202": { "description": "Receipt/index pending, insufficient confirmations or detected reorg; preserve pending state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LedgerAnchorReconciliationPending" } } } },
          "400": { "description": "Invalid request; no query parameters are accepted" },
          "409": { "description": "Exact operation evidence mismatch, reverted transaction or chain-revoked credential", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "enum": ["ledger_v2_anchor_evidence_mismatch", "ledger_v2_anchor_transaction_failed", "ledger_v2_attestation_revoked"] } } } } } },
          "413": { "description": "Request exceeds 4096 bytes" },
          "429": { "description": "Gateway concurrency limit; retry later without changing credential lifecycle" },
          "503": { "description": "Dependency unavailable, timeout or unknown current chain state; preserve pending state" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceResolution": {
        "type": "object",
        "required": ["success", "registryRevision", "service"],
        "properties": {
          "success": { "const": true },
          "registryRevision": { "type": "string" },
          "service": {
            "type": "object",
            "required": ["serviceId", "origin", "status", "accountPolicy", "endpoints"],
            "properties": {
              "serviceId": { "type": "string" }, "name": { "type": "string" }, "provider": { "type": "string" }, "origin": { "type": "string", "format": "uri" }, "status": { "const": "active" },
              "accountPolicy": { "type": "object", "required": ["mode", "maxAccounts", "policyVersion"], "properties": { "mode": { "enum": ["single", "multiple"] }, "maxAccounts": { "type": "integer" }, "policyVersion": { "const": 2 } } },
              "endpoints": { "type": "object", "required": ["challenge", "approval", "status", "exchange", "retirement"], "additionalProperties": { "type": "string", "format": "uri" } }
            }
          }
        }
      },
      "MiniProgram": { "type": "object", "required": ["id", "name", "origin", "launchUrl", "permissions"], "properties": { "id": { "type": "string" }, "serviceId": { "type": "string" }, "name": { "type": "string" }, "origin": { "type": "string", "format": "uri" }, "launchUrl": { "type": "string", "format": "uri" }, "permissions": { "type": "array", "items": { "type": "string" } } } },
      "VerificationCheck": { "type": "object", "required": ["requestType"], "properties": { "requestType": { "type": "string" }, "label": { "type": "string" }, "circuitId": { "type": "string" }, "vkId": { "type": "string" } } },
      "VerificationSession": { "type": "object", "required": ["sessionId", "status", "expiresAt"], "properties": { "sessionId": { "type": "string" }, "sessionRef": { "type": "string" }, "status": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" }, "qrPayload": { "type": "string" }, "aggregateOutcome": { "enum": ["passed", "warning", "failed"] } } },
      "LedgerAttestation": { "type": "object", "required": ["success", "status", "attestationHash"], "properties": { "success": { "const": true }, "status": { "enum": ["active", "revoked", "unknown"] }, "attestationHash": { "type": "string" }, "issuerIdHash": { "type": "string" }, "anchorBlockNumber": { "type": "integer" }, "revokeBlockNumber": { "type": "integer" } } },
      "LedgerAnchorReconciliationRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["chainId", "ledgerAddress", "requiredConfirmations", "operation", "signature"],
        "properties": {
          "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "ledgerAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "requiredConfirmations": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Cannot lower the gateway confirmation floor." },
          "candidateTransactionHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "description": "Optional known transaction. Otherwise the disposable index supplies a candidate, never proof." },
          "operation": {
            "type": "object", "additionalProperties": false,
            "required": ["attestationHash", "issuerIdHash", "holderRevocationSigner", "requestIdHash", "issuerKeyEpoch", "nonce", "deadline"],
            "properties": {
              "attestationHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
              "issuerIdHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
              "holderRevocationSigner": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "requestIdHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
              "issuerKeyEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "nonce": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,77})$", "description": "Canonical decimal uint256, no greater than 2^256-1." },
              "deadline": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Original signed Unix deadline. It may now be expired if the transaction was included in time." }
            }
          },
          "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{128}(1[bBcC])$" }
        }
      },
      "LedgerAnchorReconciliationConfirmed": {
        "type": "object", "additionalProperties": false,
        "required": ["success", "protocolVersion", "status", "receipt"],
        "properties": {
          "success": { "const": true }, "protocolVersion": { "const": 2 }, "status": { "const": "confirmed" },
          "receipt": {
            "type": "object", "additionalProperties": false,
            "required": ["chainId", "ledgerAddress", "attestationHash", "issuerIdHash", "transactionHash", "blockHash", "blockNumber", "confirmations", "requiredConfirmations", "checkedHeadHash", "checkedHeadNumber", "status"],
            "properties": {
              "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "ledgerAddress": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
              "attestationHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
              "issuerIdHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
              "transactionHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
              "blockHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
              "blockNumber": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "confirmations": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "requiredConfirmations": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "checkedHeadHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
              "checkedHeadNumber": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "status": { "const": "active" }
            }
          }
        }
      },
      "LedgerAnchorReconciliationPending": {
        "type": "object", "additionalProperties": false,
        "required": ["success", "protocolVersion", "status", "reason"],
        "properties": {
          "success": { "const": true }, "protocolVersion": { "const": 2 }, "status": { "const": "pending" },
          "reason": { "enum": ["receipt_pending", "insufficient_confirmations", "reorg_detected"] }
        }
      }
    }
  }
}
