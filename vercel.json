{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm docs:build",
  "outputDirectory": "docs/.vitepress/dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/quickstart", "destination": "/quickstarts/sign-in-with-unet", "permanent": true },
    { "source": "/docs/sign-in-with-unet", "destination": "/quickstarts/sign-in-with-unet", "permanent": true },
    { "source": "/api-reference", "destination": "/api/generated/README", "permanent": true },
    { "source": "/versions", "destination": "/changelog", "permanent": true },
    { "source": "/packages/client", "destination": "/api/generated/@u-net/client/README", "permanent": true },
    { "source": "/packages/contracts", "destination": "/api/generated/@u-net/contracts/README", "permanent": true },
    { "source": "/packages/issuer", "destination": "/api/generated/@u-net/issuer/README", "permanent": true },
    { "source": "/packages/react", "destination": "/api/generated/@u-net/react/README", "permanent": true },
    { "source": "/packages/server", "destination": "/api/generated/@u-net/server/README", "permanent": true },
    { "source": "/packages/setup", "destination": "/api/generated/@u-net/setup/README", "permanent": true },
    { "source": "/packages/verification", "destination": "/api/generated/@u-net/verification/README", "permanent": true },
    { "source": "/packages/web-login", "destination": "/api/generated/@u-net/web-login/README", "permanent": true },
    { "source": "/forum", "destination": "https://github.com/Union-networks/unet-sdk/discussions", "permanent": true },
    { "source": "/forum/:path*", "destination": "https://github.com/Union-networks/unet-sdk/discussions", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
